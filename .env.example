# ============================================================
# AK KAGAZ - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ============================================================
# DATABASE - Neon PostgreSQL
# ============================================================
# Get these from: https://console.neon.tech/app/projects
# Pooled connection (use for Prisma queries)
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?channel_binding=require&sslmode=require"

# Direct connection (use for migrations and Prisma CLI operations)
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/dbname?channel_binding=require&sslmode=require"
