# ============================================
# AK KAGAZ Frontend Environment Variables
# ============================================
# Copy this file to .env for local development
# 
# ⚠️ SECURITY: Only VITE_ prefixed variables
# are exposed to the client bundle!
# NEVER put secrets here!
# ============================================

# Backend API URL
VITE_API_URL=http://localhost:4000/api

# Public URL (for Open Graph, canonical URLs, etc.)
# In production, set this to your actual domain
VITE_PUBLIC_URL=http://localhost:3000

# Google OAuth Client ID (public, safe)
VITE_GOOGLE_CLIENT_ID=

# Google Maps API Key (restrict by domain!)
VITE_GOOGLE_MAPS_API_KEY=

# VAPID Public Key for push notifications
VITE_VAPID_PUBLIC_KEY=

# Optional features
VITE_ENABLE_ANALYTICS=false
VITE_APP_VERSION=1.0.0
