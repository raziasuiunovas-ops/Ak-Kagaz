# ============================================
# AK KAGAZ Backend Environment Variables
# ============================================
# Copy this file to .env for local development
# NEVER commit actual secrets to version control
# ============================================

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
ADMIN_URLS=http://localhost:3000

# ============================================
# DATABASE - NEON POSTGRESQL
# ============================================
# Get from: https://console.neon.tech
DATABASE_URL=
DIRECT_URL=

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
# Generate with: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
SESSION_SECRET=

# Google OAuth - https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Production Security
CSRF_SECRET=
ENCRYPTION_KEY=

# ============================================
# GROQ AI
# ============================================
# Get from: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ============================================
# RESEND (Email)
# ============================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=noreply@akkagaz.kg
EMAIL_REPLY_TO=support@akkagaz.kg

# ============================================
# TELEGRAM BOT
# ============================================
# Get from: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================
# PHOENIX PAYMENT
# ============================================
# ⚠️ Verify parameter names with official Phoenix docs!
PHOENIX_API_KEY=
PHOENIX_MERCHANT_ID=
PHOENIX_WEBHOOK_SECRET=
PHOENIX_API_URL=https://api.phoenix.kg/v1

# ============================================
# CLOUDINARY
# ============================================
# Get from: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================
# WEB PUSH NOTIFICATIONS
# ============================================
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@akkagaz.kg

# ============================================
# SMS PROVIDER (Kyrgyzstan)
# ============================================
SMS_API_KEY=
SMS_API_URL=
SMS_SENDER=AKKAGAZ

# ============================================
# GOOGLE MAPS API
# ============================================
# Get from: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=
